+++ b/web/src/admin/pages/promocodes.tsx
@@ -0,0 +1,222 @@
+import { useEffect, useState } from "react";
+import { basePath } from "../../api/client";
+
+type Promo = { id:number; code:string; kind:"percent"|"fixed"; value:number; max_uses:number; used:number; expires_at:number|null; active:boolean; created_at:number };
+const empty={code:"",kind:"percent" as const,value:10,max_uses:0,expires_at:null as number|null,active:true};
+
+async function json<T>(url:string, init?:RequestInit):Promise<T>{
+  const r=await fetch(basePath+url,{credentials:"same-origin",headers:{"Content-Type":"application/json",...(init?.headers||{})},...init});
+  if(!r.ok) throw new Error((await r.json().catch(()=>({}))).detail||`HTTP ${r.status}`);
+  return r.status===204 ? undefined as T : r.json();
+}
+
+export function PromoCodesPage(){
+  const [items,setItems]=useState<Promo[]>([]);
+  const [form,setForm]=useState(empty);
+  const [editing,setEditing]=useState<number|null>(null);
+  const [error,setError]=useState("");
+  const load=()=>json<Promo[]>("/api/v1/promocodes").then(setItems).catch(e=>setError(String(e.message||e)));
+  useEffect(()=>{void load()},[]);
+  const save=async()=>{
+    setError("");
+    try{
+      const url=editing?`/api/v1/promocodes/${editing}`:"/api/v1/promocodes";
+      const method=editing?"PATCH":"POST";
+      await json(url,{method,body:JSON.stringify(form)});
+      setForm(empty);setEditing(null);await load();
+    }catch(e){setError(String((e as Error).message||e))}
+  };
+  const remove=async(id:number)=>{if(!confirm("Удалить промокод?"))return;await json(`/api/v1/promocodes/${id}`,{method:"DELETE"});await load()};
+  return <section className="page">
+    <div className="topbar"><div><div className="page-title">Промокоды</div><div className="page-sub">Управление скидочными кодами</div></div></div>
+    <div className="card glass">
+      <div className="card-head"><div><div className="card-title">{editing?"Изменить":"Новый промокод"}</div></div></div>
+      <div className="promo-form">
+        <input className="field" placeholder="PROMO2026" value={form.code} onChange={e=>setForm({...form,code:e.target.value.toUpperCase()})}/>
+        <select className="field" value={form.kind} onChange={e=>setForm({...form,kind:e.target.value as Promo["kind"]})}><option value="percent">Процент</option><option value="fixed">Фиксированная скидка</option></select>
+        <input className="field" type="number" min="1" value={form.value} onChange={e=>setForm({...form,value:Number(e.target.value)})}/>
+        <input className="field" type="number" min="0" value={form.max_uses} onChange={e=>setForm({...form,max_uses:Number(e.target.value)})} placeholder="Лимит использований, 0 = без лимита"/>
+        <input className="field" type="datetime-local" onChange={e=>setForm({...form,expires_at:e.target.value?Math.floor(new Date(e.target.value).getTime()/1000):null})}/>
+        <label className="check-row"><input type="checkbox" checked={form.active} onChange={e=>setForm({...form,active:e.target.checked})}/> Активен</label>
+        <button className="btn btn-primary" onClick={()=>void save()}>{editing?"Сохранить":"Создать"}</button>
+        {editing?<button className="btn btn-ghost" onClick={()=>{setEditing(null);setForm(empty)}}>Отмена</button>:null}
+      </div>
+      {error?<div className="form-error">{error}</div>:null}
+    </div>
+    <div className="card glass"><div className="card-head"><div className="card-title">Коды</div></div>
+      <div className="row-list">{items.map(p=><div className="promo-row" key={p.id}><div><b>{p.code}</b><div className="muted">{p.kind==="percent"?`${p.value}%`:`${p.value} ед.`} · использовано {p.used}{p.max_uses?` / ${p.max_uses}`:""}</div></div><span className={`pill ${p.active?"ok":"off"}`}>{p.active?"активен":"выкл."}</span><button className="btn btn-sm btn-glass" onClick={()=>{setEditing(p.id);setForm({code:p.code,kind:p.kind,value:p.value,max_uses:p.max_uses,expires_at:p.expires_at,active:p.active})}}>Изменить</button><button className="btn btn-sm danger" onClick={()=>void remove(p.id)}>Удалить</button></div>)}</div>
+    </div>
+  </section>
+}
diff --git a/web/src/admin/pages/themes.tsx b/web/src/admin/pages/themes.tsx
new file mode 100644
--- /dev/null
+++ b/web/src/admin/pages/themes.tsx
@@ -0,0 +1,82 @@
+import { useEffect, useState } from "react";
+
+const themes={
+  dawn:{name:"Dawn",bg:"#fbf1e8",ink:"#161a24",accent:"#f07a2e"},
+  midnight:{name:"Midnight",bg:"#11151d",ink:"#f4f6fa",accent:"#8ab4ff"},
+  mint:{name:"Mint",bg:"#edf8f2",ink:"#17231d",accent:"#2f9e6b"},
+} as const;
+type Theme=keyof typeof themes;
+
+function apply(name:Theme){
+  const t=themes[name];
+  document.documentElement.style.setProperty("--bg",t.bg);
+  document.documentElement.style.setProperty("--ink-900",t.ink);
+  document.documentElement.style.setProperty("--mikan-500",t.accent);
+  document.documentElement.style.setProperty("--mikan-600",t.accent);
+  localStorage.setItem("mikan-theme",name);
+}
+
+export function ThemesPage(){
+  const [theme,setTheme]=useState<Theme>((localStorage.getItem("mikan-theme") as Theme)||"dawn");
+  useEffect(()=>apply(theme),[]);
+  return <section className="page">
+    <div className="topbar"><div><div className="page-title">Темы</div><div className="page-sub">Внешний вид панели сохраняется в браузере</div></div></div>
+    <div className="card glass"><div className="card-head"><div className="card-title">Цветовая тема</div></div>
+      <div className="theme-grid">{(Object.keys(themes) as Theme[]).map(k=><button key={k} className={`theme-card ${theme===k?"selected":""}`} onClick={()=>{setTheme(k);apply(k)}}><span className="theme-preview" style={{background:themes[k].bg,borderColor:themes[k].accent}}><i style={{background:themes[k].accent}}/></span><b>{themes[k].name}</b></button>)}</div>
+    </div>
+  </section>
+}
