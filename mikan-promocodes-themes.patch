diff --git a/internal/panel/api/promocodes.go b/internal/panel/api/promocodes.go
new file mode 100644
--- /dev/null
+++ b/internal/panel/api/promocodes.go
@@ -0,0 +1,255 @@
+package api
+
+import (
+	"context"
+	"database/sql"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/danielgtaylor/huma/v2"
+	"mikan/internal/panel/store"
+)
+
+type PromoCodeView struct {
+	ID        int64  `json:"id"`
+	Code      string `json:"code"`
+	Kind      string `json:"kind" enum:"percent,fixed"`
+	Value     int64  `json:"value"`
+	MaxUses   int64  `json:"max_uses"`
+	Used      int64  `json:"used"`
+	ExpiresAt *int64 `json:"expires_at"`
+	Active    bool   `json:"active"`
+	CreatedAt int64  `json:"created_at"`
+}
+
+type promoCodeBody struct {
+	Code      string `json:"code" minLength:"1" maxLength:"64"`
+	Kind      string `json:"kind" enum:"percent,fixed"`
+	Value     int64  `json:"value" minimum:"1"`
+	MaxUses   int64  `json:"max_uses" minimum:"0" default:"0" doc:"0 — без ограничения"`
+	ExpiresAt *int64 `json:"expires_at,omitempty" doc:"Unix timestamp; null — без срока"`
+	Active    bool   `json:"active"`
+}
+
+type promoCodeInput struct{ Body promoCodeBody }
+type promoCodePatchInput struct {
+	ID   int64 `path:"id" minimum:"1"`
+	Body promoCodeBody
+}
+type promoCodeIDInput struct {
+	ID int64 `path:"id" minimum:"1"`
+}
+type promoCodesOutput struct{ Body []PromoCodeView }
+type promoCodeOutput struct{ Body PromoCodeView }
+
+func (h *handlers) registerPromoCodes() {
+	tag := []string{"promocodes"}
+	huma.Register(h.api, huma.Operation{OperationID: "list-promocodes", Method: http.MethodGet, Path: "/api/v1/promocodes", Summary: "Промокоды", Tags: tag}, h.listPromoCodes)
+	huma.Register(h.api, huma.Operation{OperationID: "create-promocode", Method: http.MethodPost, Path: "/api/v1/promocodes", Summary: "Создать промокод", Tags: tag, DefaultStatus: http.StatusCreated}, h.createPromoCode)
+	huma.Register(h.api, huma.Operation{OperationID: "update-promocode", Method: http.MethodPatch, Path: "/api/v1/promocodes/{id}", Summary: "Изменить промокод", Tags: tag}, h.updatePromoCode)
+	huma.Register(h.api, huma.Operation{OperationID: "delete-promocode", Method: http.MethodDelete, Path: "/api/v1/promocodes/{id}", Summary: "Удалить промокод", Tags: tag, DefaultStatus: http.StatusNoContent}, h.deletePromoCode)
+}
+
+func (b promoCodeBody) check() error {
+	b.Code = strings.TrimSpace(b.Code)
+	if b.Code == "" {
+		return huma.Error422UnprocessableEntity("validation", &huma.ErrorDetail{Location: "body.code", Message: "code_blank"})
+	}
+	if b.Kind != "percent" && b.Kind != "fixed" {
+		return huma.Error422UnprocessableEntity("validation", &huma.ErrorDetail{Location: "body.kind", Message: "kind_invalid"})
+	}
+	if b.Kind == "percent" && b.Value > 100 {
+		return huma.Error422UnprocessableEntity("validation", &huma.ErrorDetail{Location: "body.value", Message: "percent_too_large"})
+	}
+	return nil
+}
+
+func scanPromo(rows *sql.Rows) (PromoCodeView, error) {
+	var v PromoCodeView
+	var expires int64
+	var active int64
+	if err := rows.Scan(&v.ID, &v.Code, &v.Kind, &v.Value, &v.MaxUses, &v.Used, &expires, &active, &v.CreatedAt); err != nil {
+		return v, err
+	}
+	if expires != 0 {
+		v.ExpiresAt = &expires
+	}
+	v.Active = active != 0
+	return v, nil
+}
+
+func (h *handlers) listPromoCodes(ctx context.Context, _ *struct{}) (*promoCodesOutput, error) {
+	rows, err := h.d.Store.DB.QueryContext(ctx, `SELECT id, code, kind, value, max_uses, used, COALESCE(expires_at, 0), active, created_at FROM promo_codes ORDER BY id DESC`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := &promoCodesOutput{Body: []PromoCodeView{}}
+	for rows.Next() {
+		v, err := scanPromo(rows)
+		if err != nil {
+			return nil, err
+		}
+		out.Body = append(out.Body, v)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func (h *handlers) createPromoCode(ctx context.Context, in *promoCodeInput) (*promoCodeOutput, error) {
+	b := in.Body
+	b.Code = strings.ToUpper(strings.TrimSpace(b.Code))
+	if err := b.check(); err != nil {
+		return nil, err
+	}
+	now := h.d.Now().Unix()
+	res, err := h.d.Store.DB.ExecContext(ctx, `INSERT INTO promo_codes(code, kind, value, max_uses, expires_at, active, created_at) VALUES(?,?,?,?,?,?,?)`,
+		b.Code, b.Kind, b.Value, b.MaxUses, nullableUnix(b.ExpiresAt), boolInt(b.Active), now)
+	if err != nil {
+		if store.IsUnique(err) {
+			return nil, huma.Error409Conflict("code_taken", &huma.ErrorDetail{Location: "body.code", Message: "code_taken"})
+		}
+		return nil, err
+	}
+	id, _ := res.LastInsertId()
+	h.audit(ctx, sessionOf(ctx).AdminID, "promocode.create", "promocode", strconv.FormatInt(id, 10), map[string]any{"code": b.Code})
+	return h.getPromoCode(ctx, id)
+}
+
+func (h *handlers) updatePromoCode(ctx context.Context, in *promoCodePatchInput) (*promoCodeOutput, error) {
+	b := in.Body
+	b.Code = strings.ToUpper(strings.TrimSpace(b.Code))
+	if err := b.check(); err != nil {
+		return nil, err
+	}
+	res, err := h.d.Store.DB.ExecContext(ctx, `UPDATE promo_codes SET code=?, kind=?, value=?, max_uses=?, expires_at=?, active=? WHERE id=?`,
+		b.Code, b.Kind, b.Value, b.MaxUses, nullableUnix(b.ExpiresAt), boolInt(b.Active), in.ID)
+	if err != nil {
+		if store.IsUnique(err) {
+			return nil, huma.Error409Conflict("code_taken", &huma.ErrorDetail{Location: "body.code", Message: "code_taken"})
+		}
+		return nil, err
+	}
+	n, _ := res.RowsAffected()
+	if n == 0 {
+		return nil, huma.Error404NotFound("not_found")
+	}
+	h.audit(ctx, sessionOf(ctx).AdminID, "promocode.update", "promocode", strconv.FormatInt(in.ID, 10), nil)
+	return h.getPromoCode(ctx, in.ID)
+}
+
+func (h *handlers) deletePromoCode(ctx context.Context, in *promoCodeIDInput) (*struct{}, error) {
+	res, err := h.d.Store.DB.ExecContext(ctx, `DELETE FROM promo_codes WHERE id=?`, in.ID)
+	if err != nil {
+		return nil, err
+	}
+	n, _ := res.RowsAffected()
+	if n == 0 {
+		return nil, huma.Error404NotFound("not_found")
+	}
+	h.audit(ctx, sessionOf(ctx).AdminID, "promocode.delete", "promocode", strconv.FormatInt(in.ID, 10), nil)
+	return nil, nil
+}
+
+func (h *handlers) getPromoCode(ctx context.Context, id int64) (*promoCodeOutput, error) {
+	row := h.d.Store.DB.QueryRowContext(ctx, `SELECT id, code, kind, value, max_uses, used, COALESCE(expires_at, 0), active, created_at FROM promo_codes WHERE id=?`, id)
+	var v PromoCodeView
+	var expires int64
+	var active int64
+	if err := row.Scan(&v.ID, &v.Code, &v.Kind, &v.Value, &v.MaxUses, &v.Used, &expires, &active, &v.CreatedAt); err != nil {
+		if err == sql.ErrNoRows {
+			return nil, huma.Error404NotFound("not_found")
+		}
+		return nil, err
+	}
+	if expires != 0 {
+		v.ExpiresAt = &expires
+	}
+	v.Active = active != 0
+	return &promoCodeOutput{Body: v}, nil
+}
+
+func nullableUnix(v *int64) any {
+	if v == nil {
+		return nil
+	}
+	return *v
+}
+
+func boolInt(v bool) int64 {
+	if v {
+		return 1
+	}
+	return 0
+}
