.git
**/node_modules
web/dist
docs
bin
dist
data
test/e2e/.work
*.db
*.db-*
.env
.env.*

# build output of the installer and local release files
installer/target
release

# the SDKs' build output (sdk/build.sh): a Python virtualenv made on Linux has symlinks
# that a Windows host cannot read, and the image has no use for any of it
sdk/.build
sdk/dist

# signing material never enters a build context, wherever it lies
**/*.pem
**/release-signing*

# editors, agents and local scripts
.claude
.idea
.vscode
.check.sh
**/.DS_Store
**/Thumbs.db
