* text=auto
*.sh text eol=lf
*.go text eol=lf
Dockerfile text eol=lf
# Golden files of the bot's wire: compared byte for byte, so LF on every checkout.
internal/panel/model/testdata/* text eol=lf
# Golden files of the subscription profiles (subtest.Golden): -update writes them with LF,
# so a CRLF checkout would show every file as changed after a run.
internal/sub/*/testdata/golden/* text eol=lf
