{
  "name": "mikan-sdk",
  "version": "0.0.0",
  "description": "Typed TypeScript client for the mikan panel API",
  "license": "GPL-3.0-only",
  "homepage": "https://miroshka000.github.io/mikan/api/sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miroshka000/mikan.git",
    "directory": "sdk/typescript"
  },
  "bugs": "https://github.com/Miroshka000/mikan/issues",
  "keywords": [
    "mikan",
    "vpn",
    "panel",
    "api",
    "sdk",
    "openapi"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "generate": "openapi-typescript ../.build/openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
